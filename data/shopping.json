    { "match": "gochujang|curry paste|fish sauce|mirin|wing sauce", "pkg": "1 jar or bottle", "price": 3.99, "stock": true },
    { "match": "nutritional yeast|maple syrup|cocoa powder|chocolate chips|raisins|flax|capers|green olives|couscous|wood chunks|red wine", "pkg": "1 package", "price": 3.99, "stock": true },
    { "match": "lemon juice|lime juice|orange juice", "pkg": "1 bottle", "price": 2.49, "stock": false },
    { "match": "grated ginger|^ginger", "pkg": "1 piece of fresh ginger", "price": 1.5 },
    { "match": "cilantro|parsley|thyme sprigs|(^| )sage|thai basil|scallions|dill", "pkg": "1 bunch", "price": 1.29 },
    { "match": "grated parmesan|parmesan", "pkg": "1 tub", "price": 4.49 },
    { "match": "feta", "pkg": "1 tub", "price": 3.49 },
    { "match": "mozzarella", "pkg": "1 bag (8 oz)", "price": 2.99 },
    { "match": "cheese slices", "pkg": "1 pack", "price": 3.29 },
    { "match": "buttermilk", "pkg": "1 quart", "price": 2.29 },
    { "match": "buns|pitas|slices bread|bread", "pkg": "1 pack or loaf", "price": 2.49 },
    { "match": "berries", "pkg": "1 pint", "price": 3.99 },
    { "match": "pineapple chunks|pineapple", "pkg": "1 can", "price": 2.29 },
    { "match": "granola", "pkg": "1 bag", "price": 4.49 },
    { "match": "whole-grain crackers|crackers", "pkg": "1 box", "price": 2.99 },
    { "match": "almonds|nuts", "pkg": "1 bag", "price": 5.99 },
    { "match": "kale|spinach|mixed greens", "pkg": "1 bag or bunch", "price": 2.99 },
    { "match": "firm tofu|^tofu", "pkg": "1 block (14 oz)", "price": 2.49 },
    { "match": "mushrooms", "pkg": "1 package (8 oz)", "price": 2.49 },
    { "match": "deli turkey", "pkg": "1 pack (8 oz)", "price": 4.99 },
    { "match": "bacon", "pkg": "1 pack", "price": 7 },
    { "match": "sausage links|breakfast sausage|smoked sausage|^sausage", "pkg": "1 pack", "price": 4.99 },
    { "match": "raw vegetables|^vegetables|^berries|^mixed vegetables", "pkg": "1 bag", "price": 2.99 }
  ],
  "fallback": [
    { "match": "broccoli", "pkg": "1 head or bag", "price": 2.49 },
    { "match": "cucumber", "pkg": "1 cucumber", "price": 0.8 },
    { "match": "tomato", "pkg": "1 can or 2 fresh", "price": 1.6 },
    { "match": "onion", "pkg": "1 onion", "price": 0.8 },
    { "match": "dry black beans|lentils|kidney beans", "pkg": "1 bag or can", "price": 1.99, "stock": true },
    { "match": "tortilla", "pkg": "1 pack", "price": 2.99 },
    { "match": "coconut milk|cream", "pkg": "1 can or carton", "price": 1.99 },
    { "match": "salsa", "pkg": "1 jar", "price": 3.49 },
    { "match": "garlic", "pkg": "1 head", "price": 0.75 },
    { "match": "corn|grapes|pears?$|cheese|popcorn|dark chocolate", "pkg": "1 package", "price": 3.0 }
  ],
  "loose": [
    { "match": "boneless.*(thigh|breast|chicken)|(thigh|breast|cutlet).*boneless|chicken (breast|cutlet)|^boneless|breast", "lb": 4.25, "each": 1.75, "eachLb": 0.5 },
    { "match": "whole chicken", "lb": 1.79, "each": 7.0 },
