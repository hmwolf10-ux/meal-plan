{
  "description": "Store package sizes used to turn recipe amounts into things you can actually buy. 'unit' is what the sizes are measured in (cup, tbsp, scoop, oz by weight, or count). Sizes are typical US grocery packages. Each package is [singular label, plural label, size].",
  "rules": [
    { "match": "^(whole |2% |skim )?milk$", "unit": "cup", "packages": [["gallon", "gallons", 16], ["half-gallon", "half-gallons", 8], ["quart", "quarts", 4]] },
    { "match": "greek yogurt|^yogurt", "unit": "cup", "packages": [["tub (32 oz)", "tubs (32 oz)", 4], ["tub (16 oz)", "tubs (16 oz)", 2]] },
    { "match": "cottage cheese", "unit": "cup", "packages": [["tub (24 oz)", "tubs (24 oz)", 3], ["tub (16 oz)", "tubs (16 oz)", 2]] },
    { "match": "^eggs?$", "unit": "count", "packages": [["dozen", "dozen", 12]] },
    { "match": "^butter( or oil)?$", "unit": "tbsp", "packages": [["box (1 lb, 4 sticks)", "boxes (1 lb, 4 sticks each)", 32], ["stick", "sticks", 8]] },
    { "match": "shredded cheese|^cheese$", "unit": "cup", "packages": [["bag (16 oz)", "bags (16 oz)", 4], ["bag (8 oz)", "bags (8 oz)", 2]] },
    { "match": "rolled oats|^oats", "unit": "cup", "packages": [["bag (5 lb)", "bags (5 lb)", 25], ["canister (42 oz)", "canisters (42 oz)", 13], ["canister (18 oz)", "canisters (18 oz)", 5.5]] },
    { "match": "^(dry )?([a-z-]+ )*rice$", "unit": "cup", "packages": [["bag (10 lb)", "bags (10 lb)", 24], ["bag (5 lb)", "bags (5 lb)", 12], ["bag (2 lb)", "bags (2 lb)", 4.8]] },
    { "match": "^(dry )?(brown |green )?lentils|dry black beans|dry beans", "unit": "cup", "packages": [["bag (2 lb)", "bags (2 lb)", 4.7], ["bag (1 lb)", "bags (1 lb)", 2.4]] },
    { "match": "^(rolled )?panko", "unit": "cup", "packages": [["box (8 oz)", "boxes (8 oz)", 2.7]] },
    { "match": "all-purpose flour|^flour", "unit": "cup", "packages": [["bag (5 lb)", "bags (5 lb)", 18]] },
    { "match": "brown sugar", "unit": "cup", "packages": [["bag (2 lb)", "bags (2 lb)", 4.5]] },
    { "match": "^sugar", "unit": "cup", "packages": [["bag (4 lb)", "bags (4 lb)", 9]] },
    { "match": "cornstarch", "unit": "cup", "packages": [["box (16 oz)", "boxes (16 oz)", 3.5]] },
    { "match": "peanut butter", "unit": "tbsp", "packages": [["jar (28 oz)", "jars (28 oz)", 56], ["jar (16 oz)", "jars (16 oz)", 32]] },
    { "match": "honey", "unit": "cup", "packages": [["bottle (24 oz)", "bottles (24 oz)", 2], ["bottle (12 oz)", "bottles (12 oz)", 1]] },
    { "match": "soy sauce", "unit": "cup", "packages": [["bottle (15 oz)", "bottles (15 oz)", 1.9], ["bottle (10 oz)", "bottles (10 oz)", 1.25]] },
    { "match": "olive oil|^oil|neutral oil", "unit": "cup", "packages": [["bottle (33.8 oz)", "bottles (33.8 oz)", 4], ["bottle (16.9 oz)", "bottles (16.9 oz)", 2]] },
    { "match": "vinegar", "unit": "cup", "packages": [["bottle (16 oz)", "bottles (16 oz)", 2]] },
    { "match": "hot sauce|sriracha", "unit": "cup", "packages": [["bottle (12 oz)", "bottles (12 oz)", 1.5]] },
    { "match": "broth|stock", "unit": "cup", "packages": [["carton (32 oz)", "cartons (32 oz)", 4]] },
    { "match": "salsa", "unit": "cup", "packages": [["jar (24 oz)", "jars (24 oz)", 3], ["jar (16 oz)", "jars (16 oz)", 2]] },
    { "match": "marinara|pasta sauce", "unit": "cup", "packages": [["jar (24 oz)", "jars (24 oz)", 3]] },
    { "match": "bbq sauce", "unit": "cup", "packages": [["bottle (18 oz)", "bottles (18 oz)", 1.6]] },
    { "match": "hummus", "unit": "cup", "packages": [["tub (10 oz)", "tubs (10 oz)", 1.1]] },
    { "match": "frozen mixed vegetables|mixed vegetables|frozen vegetables", "unit": "cup", "packages": [["bag (12 oz)", "bags (12 oz)", 2.4]] },
    { "match": "whey protein powder", "unit": "scoop", "packages": [["tub (about 30 scoops)", "tubs (about 30 scoops each)", 30]] },
    { "match": "^bananas?$", "unit": "count", "packages": [["bunch (5-6)", "bunches (5-6 each)", 5]] },
    { "match": "^garlic( cloves)?$", "unit": "count", "packages": [["head (about 10 cloves)", "heads (about 10 cloves each)", 10]] },
    { "match": "corn tortillas", "unit": "count", "packages": [["pack (30-count)", "packs (30-count)", 30]] },
    { "match": "tortillas", "unit": "count", "packages": [["pack (10-count)", "packs (10-count)", 10]] },
    { "match": "crushed tomatoes|diced tomatoes", "unit": "oz", "packages": [["can (28 oz)", "cans (28 oz)", 28], ["can (14.5 oz)", "cans (14.5 oz)", 14.5]] },
    { "match": "coconut milk", "unit": "oz", "packages": [["can (13.5 oz)", "cans (13.5 oz)", 13.5]] },
    { "match": "^pasta|^orzo", "unit": "oz", "packages": [["box (1 lb)", "boxes (1 lb)", 16]] },
    { "match": "egg noodles", "unit": "oz", "packages": [["bag (12 oz)", "bags (12 oz)", 12]] },
    { "match": "tuna", "unit": "count", "packages": [["can (5 oz)", "cans (5 oz)", 1]] },
    { "match": "beans$|chickpeas", "unit": "count", "packages": [["can (15 oz)", "cans (15 oz)", 1]] }
  ]
}
