{
  "description": "How recipe amounts turn into things you buy, with rough US grocery prices (2025-26 averages, will vary by store and city). 'rules': packaged items; each package is [singular, plural, size in the rule's unit, price]. The app picks ONE kind of package per item (fewest packages, least left over); 'stock': true means a pantry staple that lasts weeks, so it gets the biggest package you would use up in about six weeks. 'cupPer' converts cups to cans. 'fixed': items bought as one thing whatever the amount (a jar of cumin, a bunch of cilantro). 'loose': items priced per lb or each.",
  "rules": [
    { "match": "^frozen vegetable mix$", "unit": "oz", "packages": [["bag (16 oz)", "bags (16 oz)", 16, 2], ["bag (32 oz)", "bags (32 oz)", 32, 4]] },
    { "match": "^(whole |2% |skim )?milk$", "unit": "cup", "packages": [["gallon", "gallons", 16, 4.19], ["half-gallon", "half-gallons", 8, 2.79], ["quart", "quarts", 4, 1.99]] },
    { "match": "greek yogurt|^yogurt", "unit": "cup", "packages": [["tub (32 oz)", "tubs (32 oz)", 4, 5.49], ["tub (16 oz)", "tubs (16 oz)", 2, 3.29]] },
    { "match": "cottage cheese", "unit": "cup", "packages": [["tub (24 oz)", "tubs (24 oz)", 3, 3.99], ["tub (16 oz)", "tubs (16 oz)", 2, 2.99]] },
    { "match": "^eggs?$", "unit": "count", "packages": [["dozen", "dozen", 12, 3.59], ["18-count", "18-counts", 18, 5.49]] },
    { "match": "^butter( or oil)?$", "unit": "tbsp", "packages": [["box (1 lb, 4 sticks)", "boxes (1 lb, 4 sticks each)", 32, 4.99]] },
    { "match": "shredded cheese|^cheese$", "unit": "cup", "packages": [["bag (16 oz)", "bags (16 oz)", 4, 5.49], ["bag (8 oz)", "bags (8 oz)", 2, 2.99]] },
    { "match": "rolled oats|^oats", "unit": "cup", "stock": true, "packages": [["bag (5 lb)", "bags (5 lb)", 25, 6.99], ["canister (42 oz)", "canisters (42 oz)", 13, 5.49], ["canister (18 oz)", "canisters (18 oz)", 5.5, 3.49]] },
    { "match": "^(dry )?([a-z-]+ )*rice$", "unit": "cup", "stock": true, "packages": [["bag (10 lb)", "bags (10 lb)", 24, 8.99], ["bag (5 lb)", "bags (5 lb)", 12, 4.99], ["bag (2 lb)", "bags (2 lb)", 4.8, 2.49]] },
    { "match": "^(dry )?(brown |green |red )?lentils|dry black beans|dry beans", "unit": "cup", "stock": true, "packages": [["bag (2 lb)", "bags (2 lb)", 4.7, 3.49], ["bag (1 lb)", "bags (1 lb)", 2.4, 1.99]] },
    { "match": "^(rolled )?panko", "unit": "cup", "stock": true, "packages": [["box (8 oz)", "boxes (8 oz)", 2.7, 2.99]] },
    { "match": "all-purpose flour|^flour", "unit": "cup", "stock": true, "packages": [["bag (5 lb)", "bags (5 lb)", 18, 3.49]] },
    { "match": "brown sugar", "unit": "cup", "stock": true, "packages": [["bag (2 lb)", "bags (2 lb)", 4.5, 2.99]] },
    { "match": "^sugar", "unit": "cup", "stock": true, "packages": [["bag (4 lb)", "bags (4 lb)", 9, 3.49]] },
    { "match": "cornstarch", "unit": "cup", "stock": true, "packages": [["box (16 oz)", "boxes (16 oz)", 3.5, 2.49]] },
    { "match": "peanut butter", "unit": "tbsp", "stock": true, "packages": [["jar (28 oz)", "jars (28 oz)", 56, 4.99], ["jar (16 oz)", "jars (16 oz)", 32, 2.99]] },
    { "match": "honey", "unit": "cup", "stock": true, "packages": [["bottle (24 oz)", "bottles (24 oz)", 2, 6.99], ["bottle (12 oz)", "bottles (12 oz)", 1, 4.49]] },
    { "match": "soy sauce", "unit": "cup", "stock": true, "packages": [["bottle (15 oz)", "bottles (15 oz)", 1.9, 2.99], ["bottle (10 oz)", "bottles (10 oz)", 1.25, 2.29]] },
    { "match": "olive oil|^oil|neutral oil", "unit": "cup", "stock": true, "packages": [["bottle (33.8 oz)", "bottles (33.8 oz)", 4, 9.99], ["bottle (16.9 oz)", "bottles (16.9 oz)", 2, 5.99]] },
    { "match": "vinegar", "unit": "cup", "stock": true, "packages": [["bottle (16 oz)", "bottles (16 oz)", 2, 2.29]] },
    { "match": "hot sauce|sriracha", "unit": "cup", "stock": true, "packages": [["bottle (12 oz)", "bottles (12 oz)", 1.5, 2.49]] },
    { "match": "broth|stock", "unit": "cup", "stock": true, "packages": [["carton (32 oz)", "cartons (32 oz)", 4, 2.49]] },
    { "match": "salsa", "unit": "cup", "packages": [["jar (24 oz)", "jars (24 oz)", 3, 3.49], ["jar (16 oz)", "jars (16 oz)", 2, 2.79]] },
    { "match": "marinara|pasta sauce", "unit": "cup", "packages": [["jar (24 oz)", "jars (24 oz)", 3, 2.99]] },
    { "match": "bbq sauce", "unit": "cup", "stock": true, "packages": [["bottle (18 oz)", "bottles (18 oz)", 1.6, 2.49]] },
    { "match": "hummus", "unit": "cup", "packages": [["tub (10 oz)", "tubs (10 oz)", 1.1, 3.49]] },
    { "match": "frozen mixed vegetables|mixed vegetables|frozen vegetables|frozen green beans|frozen peas|^corn$|frozen corn", "unit": "cup", "packages": [["bag (12 oz)", "bags (12 oz)", 2.4, 1.49]] },
    { "match": "whey protein powder", "unit": "scoop", "stock": true, "packages": [["tub (about 30 scoops)", "tubs (about 30 scoops each)", 30, 29.99]] },
    { "match": "^(ripe )?bananas?$", "unit": "count", "packages": [["bunch (5-6)", "bunches (5-6 each)", 5, 1.69]] },
    { "match": "^garlic( cloves)?$", "unit": "count", "packages": [["head (about 10 cloves)", "heads (about 10 cloves each)", 10, 0.75]] },
    { "match": "corn tortillas", "unit": "count", "packages": [["pack (30-count)", "packs (30-count)", 30, 2.99]] },
    { "match": "tortillas", "unit": "count", "packages": [["pack (10-count)", "packs (10-count)", 10, 2.99]] },
    { "match": "crushed tomatoes|diced tomatoes", "unit": "oz", "stock": true, "packages": [["can (28 oz)", "cans (28 oz)", 28, 2.29], ["can (14.5 oz)", "cans (14.5 oz)", 14.5, 1.29]] },
    { "match": "coconut milk", "unit": "oz", "stock": true, "packages": [["can (13.5 oz)", "cans (13.5 oz)", 13.5, 1.99]] },
    { "match": "^pasta|^orzo|elbow pasta|spaghetti", "unit": "oz", "stock": true, "packages": [["box (1 lb)", "boxes (1 lb)", 16, 1.49]] },
    { "match": "egg noodles", "unit": "oz", "stock": true, "packages": [["bag (12 oz)", "bags (12 oz)", 12, 2.29]] },
    { "match": "tuna", "unit": "count", "stock": true, "packages": [["can (5 oz)", "cans (5 oz)", 1, 1.29]] },
    { "match": "beans$|chickpeas|edamame", "unit": "count", "cupPer": 1.5, "stock": true, "packages": [["can (15 oz)", "cans (15 oz)", 1, 1.09]] }
  ],
  "fixed": [
    { "match": "^(kosher |sea )?salt|^pepper|black pepper|peppercorn|garlic powder|onion powder|paprika|cumin|oregano|chili powder|italian seasoning|turmeric|cinnamon|taco seasoning|garam masala|cayenne|coriander|bay leaf|bay leaves|curry powder|cajun seasoning|allspice|red pepper flakes|dried thyme|^thyme$|^rub$|bbq rub|^vanilla|baking powder|dried red chilies|dried.*oregano|seasoning|sesame seeds", "pkg": "1 jar", "price": 3.0, "stock": true },
    { "match": "sesame oil", "pkg": "1 bottle", "price": 4.49, "stock": true },
    { "match": "dijon|^mustard", "pkg": "1 jar", "price": 2.99, "stock": true },
