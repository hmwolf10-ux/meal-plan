    {
      "@type": "Recipe",
      "id": "batch-chicken-thighs",
      "name": "Batch Baked Chicken Thighs",
      "description": "Bone-in, skin-on chicken thighs. Crispy skin, juicy meat. Foundation protein for the week.",
      "category": "batch",
      "tags": ["chicken", "batch-prep", "high-protein", "keto-friendly"],
      "yield": {
        "quantity": 14,
        "unit": "portions (10 oz each)"
      },
      "prepTime": "PT5M",
      "cookTime": "PT40M",
      "totalTime": "PT45M",
      "difficulty": "easy",
      "servings": 10,
      "nutrition": {
        "calories": 220,
        "protein": { "value": 35, "unit": "g" },
        "carbs": { "value": 0, "unit": "g" },
        "fat": { "value": 10, "unit": "g" }
      },
      "cost": {
        "total": 12,
        "currency": "USD",
        "perServing": 1.20
      },
      "storage": {
        "refrigerated": 4,
        "frozen": 90,
        "unit": "days"
      },
      "ingredients": [
        { "item": "bone-in, skin-on chicken thighs", "quantity": 10, "unit": "lb" },
        { "item": "salt", "quantity": 3, "unit": "tbsp" },
        { "item": "black pepper", "quantity": 2, "unit": "tbsp" },
        { "item": "garlic powder", "quantity": 2, "unit": "tbsp" },
        { "item": "paprika (smoked or regular)", "quantity": 1, "unit": "tbsp" },
        { "item": "onion powder", "quantity": 1, "unit": "tbsp" },
        { "item": "cayenne", "quantity": 1, "unit": "tsp", "optional": true }
      ],
      "instructions": [
        {
          "step": 1,
          "instruction": "Preheat oven to 400°F. Line two sheet pans with foil."
        },
        {
          "step": 2,
          "instruction": "Pat chicken completely dry with paper towels (essential for crispy skin)"
        },
        {
          "step": 3,
          "instruction": "Mix salt, pepper, garlic powder, paprika, onion powder, cayenne in a bowl"
        },
        {
          "step": 4,
          "instruction": "Season all pieces generously on both sides"
        },
        {
          "step": 5,
          "instruction": "Distribute evenly on two pans (don't crowd them)"
        },
        {
          "step": 6,
          "instruction": "Bake 38-42 minutes. Done when skin is golden-brown and juices run clear"
        },
        {
          "step": 7,
          "instruction": "Rest 5 minutes. Cool on pans before refrigerating"
        }
      ],
      "notes": "Bone-in thighs stay juicy even if slightly overcooked. This is the best protein base for the system."
    },
