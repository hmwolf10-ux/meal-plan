        "fat": { "value": 0, "unit": "g" }
      },
      "cost": {
        "total": 1.50,
        "currency": "USD",
        "perServing": 0.10
      },
      "storage": {
        "refrigerated": 5,
        "frozen": 90,
        "unit": "days"
      },
      "ingredients": [
        { "item": "dry white rice", "quantity": 5, "unit": "cups" },
        { "item": "water", "quantity": 7.5, "unit": "cups" },
        { "item": "salt", "quantity": 0.5, "unit": "tsp" }
      ],
      "instructions": [
        {
          "step": 1,
          "instruction": "Rinse rice in strainer under cold water for 30 seconds"
        },
        {
          "step": 2,
          "instruction": "Add rice, water, and salt to pot with tight-fitting lid"
        },
        {
          "step": 3,
          "instruction": "Bring to boil over high heat"
        },
        {
          "step": 4,
          "instruction": "Reduce to lowest setting and cover immediately"
        },
        {
          "step": 5,
          "instruction": "Cook for exactly 18 minutes. Do not lift lid."
        },
        {
          "step": 6,
          "instruction": "Remove from heat and let sit covered for 5 more minutes"
        },
        {
          "step": 7,
          "instruction": "Fluff with fork. Spread on sheet pan to cool before storing."
        }
      ]
    },
