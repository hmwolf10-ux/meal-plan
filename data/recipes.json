        },
        {
          "step": 3,
          "instruction": "Let sit 1-2 minutes undisturbed to brown the bottom"
        },
        {
          "step": 4,
          "instruction": "Break apart with spatula and continue cooking"
        },
        {
          "step": 5,
          "instruction": "Cook until no pink remains, approximately 8-10 minutes total"
        },
        {
          "step": 6,
          "instruction": "Season with salt and pepper to taste"
        },
        {
          "step": 7,
          "instruction": "Tilt pan and spoon off excess fat (or drain in colander)"
        },
        {
          "step": 8,
          "instruction": "Cool before refrigerating"
        }
